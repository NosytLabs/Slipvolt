# Slipvolt — server-side configuration. Never commit a filled .env file.
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:8000
KEY_PEPPER=
DATABASE_PATH=data/gridraft.db

# Dedicated OpenBroker account. Never expose this obk- key to browsers/customers.
OPENBROKER_API_KEY=
# Separate operator console credential. Use 32+ random characters in production.
ADMIN_API_KEY=

# Holder membership
ACCESS_MODE=holder_allowance
HOLDER_MINT=
# Placeholder only. Before setting a real mint, choose and publish an explicit threshold.
# Example: 10,000 whole tokens at six decimals = 10000000000 raw units.
MIN_HOLDING_RAW=1
HOLDER_TOKEN_SYMBOL=project tokens
HOLDER_TOKEN_DECIMALS=6
SOLANA_RPC_URL=
# WSS is private configuration only; this version does not start subscriptions.
SOLANA_WSS_URL=
SOLANA_RPC_RPS=15
SOLANA_RPC_CONCURRENCY=8
# Exact API base from the installed add-on; NOT a QuickNode dashboard page.
# Blank keeps quotes disabled. No transaction building or submission is enabled.
METIS_API_URL=
# Reserved configuration only. 0x execution is not implemented.
ZEROX_API_URL=
HOLDER_DAILY_TOKENS=250000
GLOBAL_DAILY_TOKENS=1000000
# Conservative local GNK reservation factor. OpenBroker documents 10 ngonka/attempt
# and typically ~10–25 effective with redundancy. 25 is intentionally conservative.
ALLOWANCE_NGONKA_PER_TOKEN=25

# Rate/capacity limits. These are Slipvolt limits, not claims about OpenBroker capacity.
REQUESTS_PER_MINUTE=30
WALLET_CONCURRENCY=4
GLOBAL_REQUESTS_PER_MINUTE=300
GLOBAL_CONCURRENCY=50
DEFAULT_OUTPUT_TOKENS=4096
MAX_OUTPUT_TOKENS=16384
MAX_REQUEST_BYTES=10485760
UPSTREAM_TIMEOUT_SECONDS=180

# Planned metered/overage rate card, integer nano-USD per token:
# 75 => $0.075 / 1M input; 300 => $0.30 / 1M output.
RETAIL_INPUT_NUSD_PER_TOKEN=75
RETAIL_OUTPUT_NUSD_PER_TOKEN=300
# Legacy flat prepaid rate only. Leave blank on new installs.
RETAIL_NUSD_PER_TOKEN=
DAILY_BUDGET_NUSD=10000000000
WALLET_DAILY_BUDGET_NUSD=2000000000

# Treasury display only. Keep self-custody GNK separate from broker spendable balance.
GONKA_TREASURY_ADDRESS=
PUBLIC_BROKER_BALANCE=false

# Optional display name only; does not move OMA-AI production or alter key identity.
SITE_NAME=Slipvolt
